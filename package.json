{
  "name": "jobpilot",
  "version": "2.1.38",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "personal:doctor": "bun scripts/personal/cli.ts doctor",
    "personal:tools:setup": "bun scripts/personal/cli.ts tools-setup",
    "personal:recruiting": "bun scripts/personal/recruiting.ts",
    "personal:setup": "bun scripts/personal/cli.ts setup",
    "personal:dev": "bun scripts/personal/cli.ts dev",
    "personal:preview": "bun scripts/personal/cli.ts preview",
    "personal:typecheck": "bun --cwd=apps/api run typecheck --project ../../scripts/personal/tsconfig.json",
    "dev": "concurrently -k -n terminal,api,web -c cyan,magenta,green \"dotnet run --project apps/terminal\" \"bun --cwd=apps/api run dev\" \"bun --cwd=apps/web run dev\"",
    "dev:api": "bun --cwd=apps/api run dev",
    "dev:web": "bun --cwd=apps/web run dev",
    "dev:terminal": "dotnet run --project apps/terminal",
    "test": "bun --cwd=apps/api run test && bun --cwd=packages/contracts run test",
    "db:tunnel": "bash apps/api/scripts/db-tunnel.sh",
    "db:setup": "bun --cwd=apps/api run db:generate && bun --cwd=apps/api run db:migrate:apply && bun --cwd=apps/api run db:seed",
    "build:api": "bun --cwd=apps/api run build",
    "build:web": "bun --cwd=apps/web run build",
    "build:terminal": "dotnet publish apps/terminal -c Release -o dist/terminal",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "ci": "biome ci --error-on-warnings .",
    "knip": "knip",
    "personal:reassess": "bun scripts/personal/cli.ts reassess",
    "personal:discover": "bun scripts/personal/cli.ts discover",
    "personal:search": "bun scripts/personal/cli.ts search",
    "personal:tailor": "bun scripts/personal/cli.ts tailor",
    "personal:tailor-review": "bun scripts/personal/cli.ts tailor-review",
    "personal:registry": "bun scripts/personal/cli.ts registry",
    "personal:digest": "bun scripts/personal/cli.ts digest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.3.14",
    "concurrently": "^10.0.3",
    "knip": "^6.34.0"
  }
}
