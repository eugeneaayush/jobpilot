# Production environment for the JobPilot stack.
# On deploy this file is written from the ENV_DOCKER GitHub secret, and the
# workflow appends GITHUB_REPOSITORY=<owner>/<repo> (lowercased) for the image refs.

# --- Database (external / managed Postgres) ---
DATABASE_URL=postgresql://user:password@db-host:5432/jobpilot

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=30d

# Wraps each user's data-encryption key. Generate with: openssl rand -base64 32
SECRET_MASTER_KEY=change-me-base64-of-32-bytes

# The single super admin
SUPER_ADMIN_EMAIL=

# --- URLs (single origin) ---
CORS_ORIGINS=https://jobpilot.suxrobgm.net
APP_URL=https://jobpilot.suxrobgm.net
GOOGLE_OAUTH_REDIRECT_URI=https://jobpilot.suxrobgm.net/api/email/oauth/callback

# --- Google/GitHub sign-in (shared app OAuth clients; unset = provider disabled) ---
# Register callbacks: {AUTH_OAUTH_REDIRECT_BASE}/api/auth/providers/{google,github}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_OAUTH_REDIRECT_BASE=https://jobpilot.suxrobgm.net

# --- Storage ---
STORAGE_ROOT=./storage

# --- Email (required here: unset = verification and reset emails are not sent) ---
RESEND_API_KEY=
EMAIL_FROM=JobPilot <noreply@jobpilot.suxrobgm.net>

LOG_LEVEL=info
