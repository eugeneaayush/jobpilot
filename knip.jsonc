{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-knipignore"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/personal/{cli,pilot,account,recruiting}.ts",
        "plugin/scripts/personal-browser.ts",
        "playwright.personal.config.ts",
        "tests/personal-ui/**/*.spec.ts"
      ],
      "project": [
        "scripts/personal/**/*.ts",
        "plugin/scripts/**/*.ts",
        "tests/personal-ui/**/*.ts"
      ],
      // GitHub-hosted runners ship jq; the release workflow just calls it.
      "ignoreBinaries": ["jq"]
    },
    "apps/api": {
      "entry": ["src/**/*.test.ts", "prisma.config.ts", "scripts/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "prisma/seed/**/*.ts", "scripts/*.ts"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": false,
      // prisma.config.ts reads DATABASE_URL at load, which crashes knip's plugin loader.
      "prisma": false,
      // pg is reached through @prisma/adapter-pg, pino-pretty by transport name only,
      // @prisma/client only from the gitignored generated client knip cannot read.
      "ignoreDependencies": ["pino-pretty", "@prisma/client"]
    },
    "apps/web": {
      "entry": ["src/components/features/personal/harness-entry.tsx"],
      "project": ["src/**/*.{ts,tsx,mdx}"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": false,
      // server-only ships inside next.
      "ignoreDependencies": ["server-only"]
    },
    "packages/contracts": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": false
    },
    "packages/api-client": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": false,
      // tsconfig sets jsxImportSource for the apps/api sources it types through paths.
      "ignoreDependencies": ["react"]
    }
  }
}
